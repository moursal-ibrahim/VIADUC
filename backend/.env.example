PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Production: comma-separated Netlify URLs, e.g.
# CLIENT_URL=https://viaduc.netlify.app,https://viaducholhol.netlify.app

# Firebase Admin SDK — choose ONE of the two options below.
# If neither is set, the backend runs with an in-memory mock store.

# Option A (easiest): download the service account JSON from
# Firebase Console > Project Settings > Service accounts > Generate new private key,
# save it as backend/serviceAccountKey.json (auto-detected), OR point to it here:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: paste the three values inline (escape newlines in the key as \n)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C (Render recommended): upload JSON as a Secret File, then set:
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json
